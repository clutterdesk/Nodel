#pragma once

#include <iostream>

#if defined(_WIN32)
    #include <windows.h>
    #include <dbghelp.h>
    #pragma comment(lib, "dbghelp.lib")
#else
    #include <execinfo.h>
    #include <unistd.h>
    #include <cxxabi.h>
#endif

namespace nodel {

class Backtrace
{
  private:
    struct Frame
    {
        intptr_t addr;
        std::string func;
        std::string file;
        int line;
    };

  public:
    Backtrace(const int max_frames) : m_max_frames{max_frames} {}

    void capture();

  private:
    int m_max_frames;
    std::vector<Frame> m_frames;
};

void Backtrace::capture() {
    m_frames.clear();

#if defined(_WIN32)
    void* stack[64];
    USHORT framesCount = CaptureStackBackTrace(0, 64, stack, nullptr);

    HANDLE process = GetCurrentProcess();
    SymInitialize(process, nullptr, TRUE);

    for (USHORT i = 0; i < framesCount; ++i) {
        Frame frame;
        frame.addr = reinterpret_cast<intptr_t>(stack[i]);
        frame.line = 0;

        char buffer[sizeof(SYMBOL_INFO) + MAX_SYM_NAME * sizeof(TCHAR)];
        SYMBOL_INFO* symbol = reinterpret_cast<SYMBOL_INFO*>(buffer);
        symbol->MaxNameLen = MAX_SYM_NAME;
        symbol->SizeOfStruct = sizeof(SYMBOL_INFO);

        DWORD64 displacement = 0;
        if (SymFromAddr(process, (DWORD64)stack[i], &displacement, symbol)) {
            char undecorated[MAX_SYM_NAME];
            if (UnDecorateSymbolName(symbol->Name, undecorated, MAX_SYM_NAME, UNDNAME_COMPLETE)) {
                frame.func = undecorated;
            } else {
                frame.func = symbol->Name;
            }
        } else {
            frame.func = "<unavailable>";
        }
        frame.file = "<unavailable>";
        m_frames.push_back(frame);
    }
    SymCleanup(process);

#else
    void* stack[64];
    int framesCount = backtrace(stack, 64);
    char** symbols = backtrace_symbols(stack, framesCount);

    for (int i = 0; i < framesCount; ++i) {
        Frame frame;
        frame.addr = reinterpret_cast<intptr_t>(stack[i]);
        frame.file = "";
        frame.line = 0;

        if (symbols) {
            // Attempt to extract and demangle the function name
            char* mangled = symbols[i];
            char* demangled = nullptr;
            int status = 0;
            demangled = abi::__cxa_demangle(mangled, nullptr, nullptr, &status);
            if (demangled && status == 0) {
                frame.func = demangled;
                free(demangled);
            } else {
                frame.func = mangled;
            }
        } else {
            frame.func = "";
        }
        m_frames.push_back(frame);
    }
    if (symbols) free(symbols);
#endif
}

} // namespace nodel
