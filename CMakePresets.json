{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (clang-cl + xwin cross-compile)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-win64",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-clang-cl.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "NODEL_WIN_PYTHON_VERSION": "3.12.10"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "targets": [ "nodel_test", "pyext_win_wheel" ]
    }
  ]
}
